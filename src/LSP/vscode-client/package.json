{
  "name": "scibasic-vbnet-lsp",
  "displayName": "sciBASIC# Remote VisualBasic.NET LSP Services",
  "description": "Connects to the VB.NET script language server over TCP to provide IntelliSense (completion, hover, signature help) for VB scripts, and launches VB scripts via vbs.exe for debugging.",
  "version": "0.1.0",
  "publisher": "xdoc",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "activationEvents": [
    "onLanguage:vbnet"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "vbnet",
        "aliases": [
          "VB.NET",
          "vbnet"
        ],
        "extensions": [
          ".vb",
          ".vbs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "debuggers": [
      {
        "type": "vbnet",
        "label": "VB.NET",
        "languages": [
          "vbnet"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "要执行的 .vb/.vbs 脚本路径（可使用 ${file} 等变量）"
              },
              "vbsPath": {
                "type": "string",
                "description": "vbs.exe 宿主路径；留空则使用设置 myRemoteLsp.vbsExecutable"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "传给脚本的命令行参数"
              }
            },
            "required": [
              "program"
            ]
          }
        },
        "configurationSnippets": [
          {
            "label": "VB.NET: Launch Script",
            "description": "启动 vbs.exe 执行一个 VB 脚本",
            "body": {
              "type": "vbnet",
              "request": "launch",
              "name": "VB.NET: Launch ${fileBasename}",
              "program": "${file}",
              "vbsPath": "${config:myRemoteLsp.vbsExecutable}",
              "args": []
            }
          }
        ],
        "debugAdapterExecutable": {
          "command": "node",
          "args": [
            "./out/debugAdapter.js"
          ]
        }
      }
    ],
    "configuration": {
      "title": "sciBASIC# Remote VB.NET LSP Services",
      "properties": {
        "myRemoteLsp.host": {
          "type": "string",
          "default": "vscode_lsp.scibasic.net",
          "description": "Host (IP / hostname) the VB.NET language server is listening on."
        },
        "myRemoteLsp.port": {
          "type": "number",
          "default": 8088,
          "description": "Port the VB.NET language server is listening on."
        },
        "myRemoteLsp.vbsExecutable": {
          "type": "string",
          "default": "G:\\GCModeller\\src\\runtime\\sciBASIC#\\.nuget\\net10.0\\vbs.exe",
          "description": "Path to the vbs.exe host used to execute VB scripts when debugging."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-debugadapter": "^1.51.0",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
